# Optional: enables real AI photo verification when scanning a clue location.
# Without this, photos are auto-accepted with a visible "AI verification disabled" notice.
# Get a key at https://console.anthropic.com/ — this is a browser-prototype pattern
# (the key ships in your client bundle), fine for personal/local use, not for a
# publicly deployed multi-user app without a backend proxy.
VITE_ANTHROPIC_API_KEY=

# Optional: override the vision model used for verification (defaults to claude-opus-4-8).
VITE_ANTHROPIC_MODEL=claude-opus-4-8
